{
  "name": "gibcord-desktop",
  "productName": "GibCord",
  "version": "1.0.7",
  "description": "GibCord — aplikacja na komputer (Windows)",
  "author": "GibCord <noreply@luisboon.pl>",
  "homepage": "https://gibcord.luisboon.pl",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --devtools",
    "test": "node --test",
    "dist": "electron-builder --win --x64 --publish never",
    "release": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "uiohook-napi": "1.5.4"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "pl.luisboon.gibcord",
    "productName": "GibCord",
    "copyright": "GibCord",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "assets/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "npmRebuild": false,
    "protocols": [
      {
        "name": "GibCord",
        "schemes": [
          "gibcord"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "GibCord-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GibCord",
      "installerLanguages": [
        "pl_PL"
      ],
      "language": "1045",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "LuisBoon",
        "repo": "gibcord-desktop",
        "releaseType": "release"
      }
    ],
    "appx": {
      "identityName": "GibCord.GibCord",
      "publisher": "CN=04559352-DF71-4AA3-A4CF-B55AA03F9922",
      "publisherDisplayName": "GibCord",
      "applicationId": "GibCord",
      "displayName": "GibCord",
      "backgroundColor": "#1b1531",
      "languages": [
        "pl-PL"
      ],
      "addAutoLaunchExtension": true,
      "showNameOnTiles": false,
      "artifactName": "GibCord-Store-${version}.${ext}"
    }
  }
}
